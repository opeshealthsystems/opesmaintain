# Copy to infra/.env.prod and fill in. Never commit the real file.
OPES_DOMAIN=maintain.example.com
REGISTRY=ghcr.io/opeshealthsystems
VERSION=1.0.0
DB_PASSWORD=
OPES_TOKEN_SECRET=          # openssl rand -base64 48
STORAGE_TYPE=s3
S3_ENDPOINT=https://s3.af-south-1.amazonaws.com
S3_BUCKET=
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=maintain@example.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_CIPHER_PASS=         # openssl rand -base64 48; store separately from the backups
